package components

import "gotta/internal/models"
import "gotta/web/helpers"

templ TodoList(todos []models.Todo) {
	if len(todos) == 0 {
		<div class="py-10 text-center text-white/30 text-base">
			Nothing here yet
		</div>
	}
	<ul class="space-y-2">
		for _, t := range todos {
			<li
				x-show={ helpers.VisibilityExpr(t.Completed) }
				x-transition.opacity.duration.200ms
				class="flex items-center justify-between gap-3
				       rounded-xl border border-white/10 px-4 py-3.5
				       bg-white/3 hover:bg-white/6
				       hover:border-white/20 transition"
			>
				<span
					class={ "text-base leading-snug flex-1 truncate transition" , templ.KV("line-through text-white/30",
			t.Completed), templ.KV("text-white/90", !t.Completed) }
				>
					{ t.Text }
				</span>
				<div class="flex items-center gap-1 shrink-0">
					<button
						hx-post={ helpers.ToggleUrl(t.ID) }
						hx-target="#todo-list"
						hx-swap="innerHTML"
						class="text-sm font-medium px-3 py-1.5 rounded-lg
						       text-amber-300 hover:bg-amber-400/15
						       active:scale-95 transition"
					>
						{ helpers.ToggleLabel(t.Completed) }
					</button>
					<button
						hx-delete={ helpers.DeleteUrl(t.ID) }
						hx-target="#todo-list"
						hx-swap="innerHTML"
						class="text-sm font-medium px-3 py-1.5 rounded-lg
						       text-red-400 hover:bg-red-400/15
						       active:scale-95 transition"
					>
						Delete
					</button>
				</div>
			</li>
		}
	</ul>
}
