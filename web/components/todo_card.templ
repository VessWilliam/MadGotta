package components

import "gotta/web/viewmodels"

templ Card(card viewmodels.CardModel){
   <div class="rounded-2xl border border-white/10 bg-white/3 backdrop-blur
	            shadow-2xl shadow-black/50 overflow-hidden">
		<!-- Header -->
		<div class="px-6 pt-6 pb-5 border-b border-white/5 flex items-center gap-3">
			<div class="w-10 h-10 rounded-xl bg-amber-400/15 border border-amber-400/30
			            grid place-items-center text-amber-300 text-lg">
				✓
			</div>
			<div class="min-w-0">
				<h1 class="text-lg font-semibold text-white truncate">{ card.Title }</h1>
				<p class="text-xs text-white/40 truncate">{ card.Description }</p>
			</div>
		</div>

		<!-- Slot -->
		{ children... }
	</div>
}